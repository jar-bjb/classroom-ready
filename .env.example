POSTGRES_USER=classroom_ready
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=classroom_ready

DATABASE_URL=postgresql://classroom_ready:change_this_password@db:5432/classroom_ready?schema=public
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3020
UPLOAD_DIR=/app/uploads
PORT=3000
HOSTNAME=0.0.0.0

# Bind only to localhost. Caddy/Cloudflare should publish the public route.
CLASSROOM_APP_BIND=127.0.0.1:3020
CLASSROOM_DB_BIND=127.0.0.1:55438

# Optional but recommended before exposing admin/supervisor/mobile routes.
# The Dashboard JAR integration endpoint remains public read-only.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
