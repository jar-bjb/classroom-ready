generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERVISOR
  INSPECTOR
  COORDINATOR
  FACILITY
  IT_AV
  MANAGEMENT
  FOLLOWUP
}

enum ChecklistCadence {
  WEEKLY
  DAILY
  POST_CLASS
  AD_HOC
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResponseType {
  OK_NOT_OK_NA
  YES_NO_NA
  TEXT
  NUMBER
}

enum ResponseValue {
  OK
  NOT_OK
  NA
  YES
  NO
  TEXT
  NUMBER
}

enum ItemCategory {
  FACILITY
  HVAC
  LIGHTING
  ELECTRICAL
  AV
  IT
  CONSUMABLE
  CLEANLINESS
  SAFETY
}

enum InspectionType {
  WEEKLY_CERTIFICATION
  DAILY_OPENING_SWEEP
  POST_CLASS_RESET
  EMERGENCY_QUICK_CHECK
}

enum InspectionSessionStatus {
  DRAFT
  SUBMITTED
  VOID
}

enum InspectionResult {
  CERTIFIED
  CERTIFIED_WITH_NOTES
  NOT_CERTIFIED
}

enum RoomCertificationStatus {
  UNCHECKED
  CERTIFIED
  CERTIFIED_WITH_NOTES
  NOT_CERTIFIED
  EXPIRED
}

enum IssuePriority {
  P1
  P2
  P3
  P4
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  username    String?  @unique
  role        UserRole @default(INSPECTOR) // primary/legacy role; capabilities live in `roles`
  roles       UserRole[] // capability set (a person can be e.g. INSPECTOR + SUPERVISOR)
  isActive    Boolean  @default(true)

  // Auth (nullable: an account can exist before it can log in). Password is set
  // by the user via a one-time activation code; the code itself is stored hashed.
  passwordHash        String?
  activationCodeHash  String?
  activationExpiresAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inspections   InspectionSession[]
  createdIssues Issue[]        @relation("IssueCreatedBy")
  resolvedIssues Issue[]       @relation("IssueResolvedBy")
  assignedIssues Issue[]       @relation("IssueAssignedTo")
  issueLogs     IssueLog[]
  notifications Notification[]
  sessions      Session[]
}

// Server-side session records. Backs revocable mobile refresh tokens; may also
// back web sessions when immediate revocation is required. Only the token hash
// is stored, never the token itself.
model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  kind        String // "web" | "mobile"
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model RoomType {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]
}

model Room {
  id                     String                  @id @default(cuid())
  code                   String                  @unique
  name                   String
  floor                  String?
  location               String?
  capacity               Int?
  typeId                 String
  status                 RoomCertificationStatus @default(UNCHECKED)
  certificationExpiresAt DateTime?
  lastInspectionId       String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  type          RoomType                    @relation(fields: [typeId], references: [id])
  inspections   InspectionSession[]
  issues        Issue[]
  itemOverrides RoomChecklistItemOverride[]

  @@index([status])
  @@index([typeId])
}

model RoomChecklistItemOverride {
  id         String       @id @default(cuid())
  roomId     String
  itemId     String
  prompt     String?
  helpText   String?
  category   ItemCategory?
  isCritical Boolean?
  isActive   Boolean      @default(true)
  sortOrder  Int?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  item ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([roomId, itemId])
  @@index([roomId, sortOrder])
}

model ChecklistTemplate {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  cadence     ChecklistCadence
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  versions ChecklistTemplateVersion[]
}

model ChecklistTemplateVersion {
  id            String                @id @default(cuid())
  templateId    String
  version       Int
  status        TemplateVersionStatus @default(DRAFT)
  effectiveFrom DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sections   ChecklistSection[]
  sessions   InspectionSession[]

  @@unique([templateId, version])
  @@index([status])
}

model ChecklistSection {
  id          String @id @default(cuid())
  versionId   String
  title       String
  description String?
  sortOrder   Int

  version ChecklistTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  items   ChecklistItem[]

  @@index([versionId, sortOrder])
}

model ChecklistItem {
  id                     String       @id @default(cuid())
  sectionId              String
  code                   String
  prompt                 String
  helpText               String?
  category               ItemCategory
  responseType           ResponseType @default(OK_NOT_OK_NA)
  isRequired             Boolean      @default(true)
  isCritical             Boolean      @default(false)
  requiresPhotoOnFail    Boolean      @default(false)
  appliesToRoomTypeSlugs String[]     @default([])
  sortOrder              Int
  weight                 Int          @default(1)
  isActive               Boolean      @default(true)

  section       ChecklistSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses     InspectionResponse[]
  roomOverrides RoomChecklistItemOverride[]

  @@unique([sectionId, code])
  @@index([category])
  @@index([sectionId, sortOrder])
}

model InspectionSession {
  id                String                  @id @default(cuid())
  roomId            String
  templateVersionId String
  inspectorId       String?
  type              InspectionType          @default(WEEKLY_CERTIFICATION)
  status            InspectionSessionStatus @default(SUBMITTED)
  result            InspectionResult
  startedAt         DateTime                @default(now())
  submittedAt       DateTime?
  expiresAt         DateTime?
  summaryNote       String?
  submissionToken   String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  room            Room                     @relation(fields: [roomId], references: [id])
  templateVersion ChecklistTemplateVersion @relation(fields: [templateVersionId], references: [id])
  inspector       User?                    @relation(fields: [inspectorId], references: [id])
  responses       InspectionResponse[]
  attachments     Attachment[]
  issues          Issue[]

  @@index([roomId, submittedAt])
  @@index([templateVersionId])
  @@index([result])
}

model InspectionResponse {
  id        String        @id @default(cuid())
  sessionId String
  itemId    String
  value     ResponseValue
  note      String?
  textValue String?
  numberValue Decimal?
  createdAt DateTime      @default(now())

  session     InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item        ChecklistItem     @relation(fields: [itemId], references: [id])
  attachments Attachment[]
  issue       Issue?

  @@unique([sessionId, itemId])
  @@index([value])
}

model Attachment {
  id           String   @id @default(cuid())
  sessionId    String?
  responseId   String?
  issueId      String?
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  publicPath   String
  caption      String?
  createdAt    DateTime @default(now())

  session  InspectionSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  response InspectionResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  issue    Issue?              @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([responseId])
  @@index([issueId])
}

model Issue {
  id          String        @id @default(cuid())
  roomId      String
  sessionId   String?
  responseId  String?       @unique
  category    ItemCategory
  title       String
  description String?
  priority    IssuePriority @default(P3)
  status      IssueStatus   @default(OPEN)
  assignedRole UserRole?
  assignedToId String? // Tahap 2: petugas Tindak Lanjut yang ditugaskan; NULL = pool bersama
  createdById String?
  resolvedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  resolvedAt  DateTime?
  resolutionNote String?

  room        Room                @relation(fields: [roomId], references: [id])
  session     InspectionSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  response    InspectionResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("IssueCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedBy  User?               @relation("IssueResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  assignedTo  User?               @relation("IssueAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  logs        IssueLog[]
  notifications Notification[]

  @@index([roomId, status])
  @@index([priority])
  @@index([category])
  @@index([resolvedById])
  @@index([assignedToId, status])
}

model IssueLog {
  id             String       @id @default(cuid())
  issueId        String
  actorId        String?
  action         String
  previousStatus IssueStatus?
  newStatus      IssueStatus?
  note           String?
  createdAt      DateTime     @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@index([actorId])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  issueId     String?
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  issue     Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@index([issueId])
}
